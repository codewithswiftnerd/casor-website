
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function profilePath() {
      return /databases/$(database)/documents/excos/$(request.auth.uid);
    }
    function hasProfile() {
      return isSignedIn() && exists(profilePath());
    }
    function myProfile() {
      return get(profilePath()).data;
    }
    function isBootstrapAdmin() {
      return isVerified() && request.auth.token.email in ['igrie318@gmail.com'];
    }
    function isApprovedExco() {
      return isBootstrapAdmin()
        || (isVerified() && hasProfile() && myProfile().status == 'approved');
    }
    function isAdmin() {
      return isBootstrapAdmin()
        || (isApprovedExco() && myProfile().get('role', 'exco') == 'admin');
    }
    function hasOffice(officeId) {
      return isApprovedExco() && myProfile().get('office', null) == officeId;
    }
    function canManageOffice(officeId) {
      return isAdmin() || hasOffice(officeId);
    }
    function isAdminArm(officeId) {
      return officeId in ['president', 'vice-president', 'general-secretary', 'asst-general-secretary'];
    }
    function allowedDocType(officeId, type) {
      return isAdminArm(officeId)
        ? type in ['Vision Statement', 'Minutes', 'Agenda', 'Proposed Semester Calendar', 'Handover Note', 'Other']
        : type in ['Vision Statement', 'Report', 'Minutes', 'Handover Note', 'Other'];
    }
    function boardPasswordPath() {
      return /databases/$(database)/documents/board_private/password;
    }
    function boardAccessPath() {
      return /databases/$(database)/documents/board_access/$(request.auth.uid);
    }
    function hasBoardAccess() {
      return isSignedIn()
        && exists(boardPasswordPath())
        && exists(boardAccessPath())
        && get(boardAccessPath()).data.key == get(boardPasswordPath()).data.key;
    }
    function isHttpsUrl(v) {
      return v is string && v.size() < 2000 && v.matches('^https://.+');
    }
    function shortText(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    function optionalText(data, key, max) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= max);
    }

    match /excos/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);

      allow create: if isSignedIn() && request.auth.uid == uid
                     && request.resource.data.keys().hasOnly(
                          ['name', 'email', 'status', 'role', 'uid', 'createdAt',
                           'requestedOffice', 'phone'])
                     && request.resource.data.status == 'pending'
                     && request.resource.data.role == 'exco'
                     && request.resource.data.uid == uid
                     && request.resource.data.email == request.auth.token.email
                     && shortText(request.resource.data.name, 120)
                     && optionalText(request.resource.data, 'requestedOffice', 80)
                     && optionalText(request.resource.data, 'phone', 40);

      allow update: if isAdmin()
                     && request.resource.data.get('uid', null) == resource.data.get('uid', null)
                     && request.resource.data.get('status', 'pending') in ['pending', 'approved', 'rejected']
                     && request.resource.data.get('role', 'exco') in ['exco', 'admin'];

      allow delete: if isAdmin();
    }

    match /approval_tokens/{uid} {
      allow read, write: if false;
    }
    match /rate_limits/{key} {
      allow read, write: if false;
    }

    match /settings/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /office_photos/{officeId} {
      allow read: if isApprovedExco();
      allow write: if canManageOffice(officeId)
                    && isHttpsUrl(request.resource.data.url);
      allow delete: if canManageOffice(officeId);
    }

    match /unit_reports/{reportId} {
      allow read: if isAdmin() || hasOffice(resource.data.unit);

      allow create: if canManageOffice(request.resource.data.unit)
                     && request.resource.data.keys().hasOnly(
                          ['unit', 'unitLabel', 'type', 'title', 'fileUrl', 'session',
                           'submittedBy', 'submittedByUid', 'submittedAt'])
                     && allowedDocType(request.resource.data.unit, request.resource.data.type)
                     && shortText(request.resource.data.title, 200)
                     && isHttpsUrl(request.resource.data.fileUrl)
                     && request.resource.data.submittedByUid == request.auth.uid;

      allow update: if canManageOffice(resource.data.unit)
                     && request.resource.data.unit == resource.data.unit
                     && request.resource.data.keys().hasOnly(
                          ['unit', 'unitLabel', 'type', 'title', 'fileUrl', 'session',
                           'submittedBy', 'submittedByUid', 'submittedAt'])
                     && allowedDocType(resource.data.unit, request.resource.data.type)
                     && shortText(request.resource.data.title, 200)
                     && isHttpsUrl(request.resource.data.fileUrl);

      allow delete: if canManageOffice(resource.data.unit);
    }

    match /meetings/{meetingId} {
      allow read: if true;
      allow create, update: if isAdmin()
                     && shortText(request.resource.data.title, 160)
                     && request.resource.data.status in ['live', 'closed'];
      allow delete: if isAdmin();
    }

    match /board_private/{docId} {
      allow read: if isApprovedExco();
      allow write: if isAdmin()
                     && docId == 'password'
                     && request.resource.data.keys().hasOnly(['password', 'key', 'updatedBy', 'updatedAt'])
                     && shortText(request.resource.data.password, 60)
                     && shortText(request.resource.data.key, 60);
    }

    match /board_access/{uid} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid
                     && request.resource.data.keys().hasOnly(['key', 'at'])
                     && request.resource.data.key is string
                     && exists(boardPasswordPath())
                     && request.resource.data.key == get(boardPasswordPath()).data.key;
    }

    match /meeting_docs/{docId} {
      allow read: if isApprovedExco() || (resource.data.visible == true && hasBoardAccess());

      allow create: if canManageOffice(request.resource.data.office)
                     && request.resource.data.keys().hasOnly(
                          ['meetingId', 'office', 'officeName', 'type', 'title', 'fileUrl',
                           'visible', 'addedBy', 'addedByUid', 'addedAt', 'sourceReportId'])
                     && request.resource.data.visible == true
                     && request.resource.data.addedByUid == request.auth.uid
                     && allowedDocType(request.resource.data.office, request.resource.data.type)
                     && shortText(request.resource.data.title, 200)
                     && isHttpsUrl(request.resource.data.fileUrl)
                     && get(/databases/$(database)/documents/meetings/$(request.resource.data.meetingId)).data.status == 'live';

      allow update: if isAdmin()
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visible']);

      allow delete: if isAdmin() || hasOffice(resource.data.office);
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isApprovedExco()
                     && request.resource.data.keys().hasOnly(
                          ['actorUid', 'actorEmail', 'action', 'collection', 'targetId', 'details', 'at'])
                     && request.resource.data.actorUid == request.auth.uid
                     && request.resource.data.at == request.time
                     && shortText(request.resource.data.action, 80)
                     && optionalText(request.resource.data, 'details', 500);
      allow update, delete: if false;
    }

    match /files/{fileId} {
      allow read, write: if isAdmin();
    }
    match /members/{memberId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
                      request.resource.data.keys().hasOnly(
                        ['name', 'phone', 'email', 'gender', 'level', 'dept', 'unit', 'dob',
                         'address', 'source', 'status', 'consent', 'submittedAt'])
                      && shortText(request.resource.data.name, 100)
                      && request.resource.data.phone is string
                      && request.resource.data.phone.matches('^[0-9+()\\- ]{10,20}$')
                      && request.resource.data.email is string && request.resource.data.email.size() <= 120
                      && request.resource.data.gender in ['', 'Male', 'Female']
                      && request.resource.data.level is string && request.resource.data.level.size() <= 20
                      && request.resource.data.dept is string && request.resource.data.dept.size() <= 100
                      && request.resource.data.unit is string && request.resource.data.unit.size() <= 80
                      && request.resource.data.dob is string && request.resource.data.dob.size() <= 10
                      && request.resource.data.address is string && request.resource.data.address.size() <= 200
                      && request.resource.data.source == 'self'
                      && request.resource.data.status == 'new'
                      && request.resource.data.consent == true
                      && request.resource.data.submittedAt == request.time
                    );
    }
    match /newsletters/{newsletterId} {
      allow read, write: if isAdmin();
    }

    match /library/{resourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /folders/{folderId} {
      allow read: if true;
      allow create, update: if isAdmin()
                     && request.resource.data.section in ['library', 'gallery']
                     && shortText(request.resource.data.name, 120);
      allow delete: if isAdmin();
    }
    match /galleryPhotos/{photoId} {
      allow read: if true;
      allow create, update: if isAdmin() && isHttpsUrl(request.resource.data.url);
      allow delete: if isAdmin();
    }
    match /site_images/{slot} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /site_content/{slot} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /presidents/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /abc_officials/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /hall_pastors/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /news/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /push_subscribers/{token} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['createdAt', 'page'])
                      && request.resource.data.page is string
                      && request.resource.data.page.size() <= 200
                      && token.size() < 400;
      allow delete: if true;
      allow update: if false;
    }

    match /subscribers/{email} {
      allow read: if isAdmin();
      allow create: if request.resource.data.status == 'active'
                      && request.resource.data.email == email
                      && email.size() <= 254
                      && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                      && request.resource.data.keys().hasOnly(
                           ['email', 'subscribedAt', 'status', 'unsubscribeToken'])
                      && request.resource.data.unsubscribeToken is string
                      && request.resource.data.unsubscribeToken.size() >= 16;
      allow update: if isAdmin() || (
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'unsubscribedAt', 'unsubscribeProof']) &&
                      request.resource.data.status == 'unsubscribed' &&
                      request.resource.data.unsubscribeToken == resource.data.unsubscribeToken &&
                      request.resource.data.unsubscribeProof == resource.data.unsubscribeToken
                    );
      allow delete: if isAdmin();
    }
  }
}
